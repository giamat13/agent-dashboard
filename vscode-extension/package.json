{
  "name": "agent-dashboard",
  "displayName": "Agent Dashboard",
  "description": "Live dashboard for Claude: to-dos, context, and long-running scripts with steps and estimated time.",
  "version": "0.4.4",
  "publisher": "giamat13",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/GIAMAT13/agent-dashboard" },
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      { "command": "agentDashboard.open", "title": "Agent Dashboard: Open in large window" },
      { "command": "agentDashboard.clear", "title": "Agent Dashboard: Clear history" },
      { "command": "agentDashboard.checkUpdates", "title": "Agent Dashboard: Check for updates" }
    ],
    "configuration": {
      "title": "Agent Dashboard",
      "properties": {
        "agentDashboard.staleMinutes": {
          "type": "number",
          "default": 3,
          "description": "Minutes without an update before showing a 'possibly stuck' warning."
        }
      }
    }
  }
}
